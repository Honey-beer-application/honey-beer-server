{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.OpenTelemetry"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://opentelemetry-collector:4318/v1/logs",
          "protocol": "http/protobuf"
        }
      }
    ],
    "Enrich": [ "LoggingContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "Data": {
    "CommandAPIConnection": {
      //"ConnectionString": "Server=mssqlserver,1433;User Id=sa;Password=stvarnoNovo10;Encrypt=no;TrustServerCertificate=True;Integrated security=False;"
      "ConnectionString": "Server=DESKTOP-L8LPP6M;User Id=honey-beer;Database=honey-beer-app;Trusted_Connection=True;Encrypt=False;"
      //"ConnectionString": "Server=DESKTOP-L8LPP6M;User Id=sa;Password=stvarnoNovo10;Encrypt=no;TrustServerCertificate=True;Integrated security=False;"
    }
  },
  "Otlp": {
    "Endpoint": "localhost:7165"
  }
}
